POSTGRES_USER=idx
POSTGRES_PASSWORD=idx
POSTGRES_DB=idx
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database cloud (Neon). Jika di-set, menggantikan POSTGRES_* di atas.
# Biarkan kosong di .env agar default tetap database lokal; set sementara di terminal saat perlu ke cloud.
# DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/idx?sslmode=require
